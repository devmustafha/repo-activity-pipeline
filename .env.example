# Copy to .env and fill in. .env is gitignored.

# --- Airflow ---
AIRFLOW_UID=50000
# Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# --- GitHub ingestion ---
# A token is strongly recommended: 5000 req/hr authenticated vs 60 without.
# A classic PAT needs `public_repo`; a fine-grained token needs read-only
# "Contents", "Issues", "Pull requests", "Metadata" on the target repos.
GITHUB_TOKEN=
GITHUB_REPOS=dbt-labs/dbt-core,duckdb/duckdb
GITHUB_API_URL=https://api.github.com
GITHUB_INITIAL_LOOKBACK_DAYS=30
GITHUB_MAX_PAGES=50

# --- Postgres (ingestion target + dbt target) ---
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require

# --- dbt ---
DBT_SCHEMA=repo_activity
DBT_THREADS=4
